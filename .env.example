# Copy to .env and replace the placeholders locally. Never commit .env.
# Supabase project -> Connect -> Direct section -> Session pooler -> URI.
# Copy the supplied pooler host and port 5432; keep SSL enabled.
# Replace only these neutral placeholders locally; URL-encode the password.
DATABASE_URL=postgresql+psycopg2://postgres.PROJECT_REF:YOUR_PASSWORD@POOLER_HOST:5432/postgres?sslmode=require

# Optional local setup helper only. Runtime reads DATABASE_URL.
# This value does not build DATABASE_URL automatically.
# SUPABASE_DB_PASSWORD=

# A real sale-listings URL with supported schema.org JSON-LD is required.
# The source-specific adapter must be checked before enabling scheduled runs.
LISTINGS_URL=
MAX_PAGES=2
MAX_LISTINGS=100
REQUEST_DELAY_SECONDS=2

# Legacy bounded sample runner: python -m src.daily_listings.
# These limits apply per portal only to that sample command.
# Current catalogue runner uses CATALOG_* below.
# GitHub scheduling is enabled separately with the PORTAL_COLLECTION_ENABLED variable.
OLX_MAX_PAGES=5
OTODOM_MAX_PAGES=5
PORTAL_MAX_LISTINGS=500

# Catalogue bootstrap / daily discovery / periodic price refresh.
# python -m src.catalog_pipeline --mode bootstrap --save-db
# Limits apply per source and include bounded request accounting.
# --save-db persists source checkpoints so later runs can resume.
CATALOG_MAX_PAGES=1000
CATALOG_MAX_LISTINGS=50000
CATALOG_MAX_REQUESTS=700

# temporal requires listing observations from several separate UTC days.
# group is an explicitly exploratory split for an initial snapshot.
TRAIN_SPLIT=temporal
DEAL_THRESHOLD=0.15

# Optional centre reference for straight-line distance, not travel distance.
WARSAW_CENTER_LAT=52.2297
WARSAW_CENTER_LON=21.0122
